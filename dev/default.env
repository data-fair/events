# Defaults of the dev environment: fixed ports, no tooling needed.
# `npm run dev-deps` copies this file to .env when there is none; .env overrides it
# (it is never overwritten, edit it freely).
# Ports stay in 5950-5999 so that they rarely collide with other local services.
DEV_HOST=localhost
# the dev servers are on loopback: allowed to the SSRF-safe http clients of the api and the tests
SSRF_PUBLIC_IPS=127.0.0.1,::1
NGINX_PORT=5950
DEV_API_PORT=5951
DEV_UI_PORT=5952
DEV_UI_HMR_PORT=5953
MONGO_PORT=5954
SD_PORT=5955
MAILDEV_UI_PORT=5956
MAILDEV_SMTP_PORT=5957
