{
  "name": "@data-fair/events",
  "version": "1.5.1",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build-types": "df-build-types ./",
    "stop-dev-deps": "docker compose --profile '*' stop",
    "dev-zellij": "df-dev zellij",
    "dev-send-notifications": "NODE_ENV=development node dev/scripts/send-notifications.ts",
    "lint": "eslint . && npm -w ui run lint",
    "lint-fix": "eslint --fix . && npm -w ui run lint-fix",
    "test": "playwright test --max-failures=1",
    "test-unit": "playwright test --project unit --max-failures=1",
    "test-api": "playwright test --project api --max-failures=1",
    "test-e2e": "playwright test --project e2e --max-failures=1",
    "check-types": "tsc && npm -w ui run check-types",
    "prepare": "husky || true",
    "quality": "npm run lint && npm run build-types && npm run check-types && npm -w ui run build && npm run test && npm audit --omit=dev --audit-level=critical"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/data-fair/events.git"
  },
  "author": "",
  "license": "MIT",
  "workspaces": [
    "ui",
    "api",
    "lib-vuetify"
  ],
  "bugs": {
    "url": "https://github.com/data-fair/events/issues"
  },
  "homepage": "https://github.com/data-fair/events#readme",
  "dependencies": {
    "@data-fair/lib-types-builder": "^1.14.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@data-fair/lib-common-types": "^1.27.0",
    "@data-fair/lib-dev": "^0.1.0",
    "@data-fair/lib-node": "^2.16.1",
    "@data-fair/lib-utils": "^1.14.1",
    "@playwright/test": "^1.58.2",
    "@types/debug": "^4.1.13",
    "@types/node": "^24.19.2",
    "axios": "^1.21.0",
    "dotenv": "^18.0.9",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.12.0",
    "eslint-plugin-vuetify": "^2.7.3",
    "husky": "^9.1.7",
    "jose": "^6.2.13",
    "neostandard": "^0.14.1",
    "nodemon": "^3.1.9",
    "tough-cookie": "^5.1.2",
    "typescript": "^6.0.3",
    "ufo": "^1.6.4",
    "ws": "^8.20.0"
  },
  "relativeDependencies": {
    "@data-fair/lib-express": "../lib/packages/express",
    "@data-fair/lib-vue": "../lib/packages/vue",
    "@data-fair/lib-vuetify": "../lib/packages/vuetify"
  },
  "engines": {
    "node": ">=24.22.1"
  }
}
